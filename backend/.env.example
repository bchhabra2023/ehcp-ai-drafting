# Microsoft Foundry
FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/
FOUNDRY_PROJECT_NAME=your-foundry-project
FOUNDRY_MODEL_NAME=gpt-5.2
FOUNDRY_API_VERSION=2025-04-01-preview

# Optional: only when you must target a specific user-assigned identity locally
AZURE_CLIENT_ID=

# Foundry model settings
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=30

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com/

# Azure Blob Storage (optional)
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=ehcp-outputs

# Azure Cosmos DB audit logging (optional)
AUDIT_LOG_ENABLED=false
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_DB_DATABASE=ehcp-audit
COSMOS_DB_CONTAINER=activity-logs
COSMOS_DB_JOB_CONTAINER=job-logs

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
